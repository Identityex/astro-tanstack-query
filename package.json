{
  "name": "astro-tanstack-query",
  "version": "0.2.0",
  "description": "Unofficial Astro integration: one TanStack Query cache shared by every island on a page — React, Svelte, Vue, Solid, Preact, Alpine, vanilla and htmx — with SSR prefetch, hydration and per-request isolation.",
  "type": "module",
  "license": "MIT",
  "author": "Travis Arsenault",
  "homepage": "https://github.com/Identityex/astro-tanstack-query#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Identityex/astro-tanstack-query.git"
  },
  "bugs": {
    "url": "https://github.com/Identityex/astro-tanstack-query/issues"
  },
  "keywords": [
    "astro-integration",
    "withastro",
    "tanstack",
    "tanstack-query",
    "nanostores",
    "islands",
    "query",
    "ssr",
    "hydration",
    "svelte",
    "react",
    "vue",
    "solid",
    "htmx"
  ],
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "components"
  ],
  "exports": {
    ".": {
      "types": "./dist/integration.d.ts",
      "default": "./dist/integration.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "default": "./dist/query/index.js"
    },
    "./actions": {
      "types": "./dist/actions/index.d.ts",
      "default": "./dist/actions/index.js"
    },
    "./htmx": {
      "types": "./dist/htmx/index.d.ts",
      "default": "./dist/htmx/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./middleware": {
      "types": "./dist/middleware.d.ts",
      "default": "./dist/middleware.js"
    },
    "./serializer/json": {
      "types": "./dist/serializer/json.d.ts",
      "default": "./dist/serializer/json.js"
    },
    "./serializer/devalue": {
      "types": "./dist/serializer/devalue.d.ts",
      "default": "./dist/serializer/devalue.js"
    },
    "./devtools/client": {
      "types": "./dist/devtools/client.d.ts",
      "default": "./dist/devtools/client.js"
    },
    "./devtools/toolbar": {
      "types": "./dist/devtools/toolbar.d.ts",
      "default": "./dist/devtools/toolbar.js"
    },
    "./components/*": "./components/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/htmx/index.js"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:oxlint && npm run lint:eslint",
    "lint:oxlint": "oxlint --disable-nested-config --config .oxlintrc.json .",
    "lint:eslint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:prod": "npm run build && npm --prefix example run build",
    "test:prod": "vitest run --config vitest.prod.config.ts",
    "check:package": "publint && attw --pack . --profile esm-only",
    "size": "size-limit",
    "e2e": "npm run build && npm --prefix example run build && playwright test",
    "changeset": "changeset",
    "release": "npm run build && changeset publish",
    "prepare": "tsdown"
  },
  "peerDependencies": {
    "@tanstack/query-core": "^5.90.0",
    "@tanstack/query-devtools": "^5.90.0",
    "astro": "^7.3.0",
    "devalue": "^5.0.0 || ^6.0.0",
    "htmx.org": "^2.0.0",
    "nanostores": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/query-devtools": {
      "optional": true
    },
    "devalue": {
      "optional": true
    },
    "htmx.org": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/esbuild": "^14.0.1",
    "@size-limit/file": "^14.0.1",
    "@tanstack/query-core": "^5.102.8",
    "@tanstack/query-devtools": "^5.102.8",
    "astro": "^7.3.2",
    "devalue": "^6.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.85.0",
    "happy-dom": "^20.14.5",
    "htmx.org": "^2.0.10",
    "lefthook": "^2.1.14",
    "nanostores": "^1.5.3",
    "oxlint": "~1.85.0",
    "prettier": "^3.9.6",
    "publint": "^0.3.24",
    "size-limit": "^14.0.1",
    "tsdown": "^0.23.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
