---
/**
 * Emits this request's dehydrated Query state where it is placed. Use with
 * `tanstackQuery({ emit: "component" })` and put it last inside <body>. It
 * captures every prefetch awaited in page or layout frontmatter. Astro renders
 * the components after an async sibling concurrently with this one, so a
 * prefetch in their frontmatter may finish after it has run; the default
 * middleware emission, which writes the state once the body has streamed,
 * captures those too.
 */
import { stateScript, warnOnLatePrefetch } from "astro-tanstack-query/server";
import { stateWriter } from "virtual:astro-tanstack-query/config";

const client = Astro.locals.queryClient;
const html = stateScript(client, stateWriter);
// Not cleared here: siblings rendering concurrently may still read the client. The middleware
// releases it once the response has streamed.
if (import.meta.env.DEV) warnOnLatePrefetch(client);
---

<Fragment set:html={html ?? ""} />
